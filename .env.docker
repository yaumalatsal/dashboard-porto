# Docker environment for the dashboard.
# Committed with safe placeholder values.
# Real secrets override here via .env.docker.local (CI/CD manages it).

# Port the Node.js app listens on inside the container
PORT=3001

# API token for the monitored site(s).
# The entrypoint injects this into sites.json for any site with an empty token.
# Leave empty to monitor without authentication context.
MONITOR_API_TOKEN=

# --- Host (VPS) metrics ---
# Where the VPS's procfs and root filesystem are mounted inside the container
# (see the volumes: block in docker-compose.yml).
HOST_PROC=/host/proc
HOST_ROOTFS=/host/rootfs

# --- Per-site traffic ---
# Directories to scan for nginx access logs, comma-separated.
#   /var/log/nginx           → the nginx in this compose file
#   /host/var/log/nginx      → the VPS's own nginx, if other sites use one
# Only files matching NGINX_LOG_PATTERN are tailed, and they must use the
# json_analytics log format defined in docker/nginx.conf.
NGINX_LOG_DIR=/var/log/nginx,/host/var/log/nginx
NGINX_LOG_PATTERN=^access.*\.log$
