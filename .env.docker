# Docker environment for the dashboard.
# Committed with safe placeholder values.
# Real secrets override here via .env.docker.local (CI/CD manages it).

# Port the Node.js app listens on inside the container
PORT=3001

# API token for the monitored site(s).
# The entrypoint injects this into sites.json for any site with an empty token.
# Leave empty to monitor without authentication context.
MONITOR_API_TOKEN=
